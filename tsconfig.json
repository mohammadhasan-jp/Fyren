{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // We import with explicit ".ts" extensions so that Node can run the
    // sources directly (native type stripping). If we ever add a build step,
    // rewriteRelativeImportExtensions turns them into ".js" on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,

    // Only allow TypeScript syntax that can be erased, never transformed.
    // This is what keeps `node src/foo.ts` working without a compiler.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // Every top-level source directory must be listed. A missing entry makes
  // `tsc --noEmit` report success without checking those files at all — this
  // has silently happened twice (test/, then bin/). See DECISIONS.md.
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts", "bin/**/*.ts", "scripts/**/*.ts"]
}
