{
  "name": "fyren-ai",
  "version": "0.2.0",
  "description": "Find where your LLM tokens and cost actually go — and which of them were avoidable. Token cost profiler for Claude, OpenAI, Gemini, Ollama and Vercel AI SDK agents. Detects missing prompt caching, wasted tool output and retries. Local CLI + web UI, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/server.d.ts",
      "default": "./dist/web/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fyren": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "fyren": "node bin/fyren.ts",
    "example": "node examples/basic-run.ts",
    "example:cost": "node examples/cost-breakdown.ts",
    "example:real": "node examples/run-real-agent.ts",
    "example:ollama": "node examples/run-ollama-agent.ts",
    "example:ai-sdk": "node examples/ai-sdk-agent.ts"
  },
  "keywords": [
    "llm",
    "llm-cost",
    "llm-observability",
    "token-usage",
    "token-counter",
    "tokens",
    "cost-tracking",
    "cost-optimization",
    "prompt-caching",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-agents",
    "agents",
    "anthropic",
    "claude",
    "openai",
    "gemini",
    "ollama",
    "observability",
    "profiler",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadhasan-jp/Fyren.git"
  },
  "homepage": "https://github.com/mohammadhasan-jp/Fyren#readme",
  "bugs": {
    "url": "https://github.com/mohammadhasan-jp/Fyren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.72",
    "@anthropic-ai/sdk": "^0.117.1",
    "@types/node": "^22.10.0",
    "ai": "^7.0.79",
    "typescript": "^5.7.0",
    "zod": "^4.4.3"
  }
}
