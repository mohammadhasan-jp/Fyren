# Dependencies
node_modules/

# Build output — dist/ is generated by `npm run build` and published to npm,
# never committed. *.tgz is what `npm pack` leaves behind.
dist/
*.tgz

# Recorded runs. This is the user's own profiling data: it can carry agent
# names, model ids and tool names from real work, and it is recreated on the
# next run. Never commit someone's run history.
.fyren/
*.db
*.db-wal
*.db-shm

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Internal working docs. Kept on disk, deliberately not published: planning,
# scope and decision records are for whoever is building this, not for someone
# evaluating or installing it. The public surface is README.md and the code.
# None of these ever reached the npm package anyway — package.json's `files`
# field only ships dist/, src/, README and LICENSE.
PRD.md
PROJECT_CONTEXT.md
DECISIONS.md
CONTRIBUTING.md
CHANGELOG.md

# Local AI-assistant config. Machine-specific (hook commands carry absolute
# paths that are wrong on every other machine) and personal to whoever happens
# to be working on the repo.
.claude/
CLAUDE.md
AGENT.md
agent.md
Agent.md
.cursor/
.aider*
.windsurfrules

# Generated knowledge graph — rebuilt from source by `graphify update .`
graphify-out/

# Scratch files. Verification snippets and half-finished drafts belong on disk
# while working, and nowhere near a commit.
*.tmp
*.tmp.*
*.bak
*.orig
scratch/
tmp/

# Test and tooling OUTPUT. The test suite itself stays committed on purpose —
# CI runs it, and for a tool whose whole pitch is "these numbers are
# trustworthy" the tests are the evidence for that claim. Only artifacts are
# ignored here; the suite is already kept out of the npm package by
# package.json's `files` field, so nobody installing fyren downloads it.
coverage/
*.lcov
.nyc_output/
test-results/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-error.log*
.npm/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
